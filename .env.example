# 任何 OpenAI 兼容的服务都可以用（OpenAI 官方、DeepSeek、中转网关）

# API Key（必填）
AI_API_KEY=

# 模型名（必填），如 gpt-4o-mini / deepseek-chat / deepseek-v4-flash-vision-exp
AI_MODEL=

# Base URL（可选）。留空走 OpenAI 官方地址
# 注意是否需要 /v1 后缀，以服务方文档为准
# DeepSeek 官方：https://api.deepseek.com
AI_BASE_URL=

# ---- 插图（文生图）----
# 默认用 Pollinations 免费服务，无需 key。留空即可
# IMAGE_BASE_URL=https://image.pollinations.ai/prompt
# IMAGE_MODEL=flux
